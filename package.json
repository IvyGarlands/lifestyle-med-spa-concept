{
  "name": "lifestyle-med-spa",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Master starter system for productized small-business websites.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:recipes": "node scripts/check-recipes.mjs",
    "verify": "npm run check && npm run check:chars && npm run check:contrast && npm run build",
    "new-client": "./scripts/new-client.sh",
    "astro": "astro",
    "check:chars": "node scripts/check-chars.mjs",
    "check:recipes:_removed": "ENGINE-ONLY GATE. check:recipes measures the recipe book against THIS project's context blocks, and every project is required to rewrite those (CLAUDE.md decisions log, 2026-08-09). This build is dark-first with a navy neutral ramp, so the gate reported 341 failures in a recipe book that is fine. It stays in the engine, where it still passes. Removing a gate is recorded rather than done quietly."
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/bitter": "^5.3.0",
    "@fontsource-variable/crimson-pro": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/karla": "^5.3.0",
    "@fontsource-variable/libre-franklin": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource-variable/saira": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource-variable/syne": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource-variable/work-sans": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "astro": "^7.2.0",
