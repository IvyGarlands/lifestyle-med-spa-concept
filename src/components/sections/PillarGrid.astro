---
/**
 * PillarGrid — the four things we do, as image cards.
 *
 * This is the section that answers "what does this business actually sell?"
 * and on the homepage it sits directly under the hero, because that is the
 * question a visitor arrives with. The team, the story and the credentials all
 * come after it.
 *
 * Every card carries a real photograph. There is no text-only variant on
 * purpose: an empty card is the blank space this layout exists to prevent.
 */
import { Picture } from "astro:assets";
import Section from "./Section.astro";
import SectionIntro from "./SectionIntro.astro";
import type { SectionProps } from "./Section.astro";
import type { ImageMetadata } from "astro";

export interface Pillar {
  title: string;
  body: string;
  href: string;
  image: ImageMetadata;
  alt: string;
  /** Short list of what sits under this pillar. */
  items?: string[];
}

interface Props extends SectionProps {
  eyebrow?: string;
  heading: string;
  accent?: string;
  lead?: string;
  pillars: Pillar[];
  align?: "start" | "center";
}

const {
  eyebrow,
  heading,
  accent,
  lead,
  pillars,
  align = "center",
  id = "services",
  tone,
  spacing,
  ...rest
} = Astro.props;
---

<Section
  id={id}
  tone={tone}
  spacing={spacing}
  width="xl"
  labelledBy={`${id}-heading`}
  {...rest}
>
  <SectionIntro
    eyebrow={eyebrow}
    heading={heading}
    accent={accent}
    lead={lead}
    align={align}
    headingId={`${id}-heading`}
  />

  <ul class="pillars" data-reveal-stagger>
    {
      pillars.map((p) => (
        <li class="pillar" data-reveal>
          <a class="pillar__link" href={p.href}>
            <span class="pillar__media">
              <Picture
                src={p.image}
                alt={p.alt}
                widths={[360, 560, 760, 1020]}
                sizes="(min-width: 64em) 22vw, (min-width: 40em) 44vw, 88vw"
                formats={["avif", "webp"]}
          layout="none"
                loading="lazy"
                class="pillar__img"
              />
            </span>

            <span class="pillar__body">
              <span class="pillar__title">{p.title}</span>
              <span class="pillar__text">{p.body}</span>
              {p.items && (
                <span class="pillar__items">{p.items.join(" · ")}</span>
              )}
              <span class="pillar__cta">See what we offer</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .pillars {
    display: grid;
    gap: var(--space-m);
    margin: var(--space-xl) 0 0;
    padding: 0;
    list-style: none;
    grid-template-columns: 1fr;
  }

  @media (min-width: 38em) {
    .pillars {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64em) {
    .pillars {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .pillar {
    display: flex;
  }

  .pillar__link {
    display: flex;
    flex-direction: column;
    inline-size: 100%;
    overflow: hidden;
    border-radius: var(--radius-card);
    border: var(--border-hair) solid var(--color-line);
    background-color: var(--color-surface);
    color: inherit;
    text-decoration: none;
    transition:
      transform var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }

  .pillar__link:hover {
    transform: translateY(-3px);
    border-color: var(--color-brand);
    box-shadow: var(--shadow-m);
  }

  .pillar__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-image: var(--grad-ink-soft);
  }

  .pillar__img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    filter: var(--image-filter);
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .pillar__link:hover .pillar__img {
    transform: scale(var(--image-hover-scale));
  }

  /* A gold hairline under the photo, so the image and the card read as one
     object rather than a picture with a caption stuck below it. */
  .pillar__media::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    block-size: 2px;
    background-image: var(--grad-gold);
    opacity: 0.85;
  }

  .pillar__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: var(--space-2xs);
    padding: var(--space-m);
  }

  .pillar__title {
    font-family: var(--face-display);
    font-size: var(--step-2);
    font-weight: var(--weight-display);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-ink-strong);
  }

  .pillar__text {
    font-size: var(--step-0);
    line-height: var(--leading-snug);
    color: var(--color-ink);
  }

  .pillar__items {
    font-size: var(--step--1);
    line-height: var(--leading-snug);
    color: var(--color-ink-muted);
  }

  .pillar__cta {
    margin-block-start: auto;
    padding-block-start: var(--space-2xs);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--color-brand);
  }

  .pillar__cta::after {
    content: " →";
  }
</style>
