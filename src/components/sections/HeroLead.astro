---
/**
 * HeroLead — the hero, rebuilt product-first.
 *
 * The previous hero put the staff roster above the fold. Wrong order: the
 * first question a visitor has is "what does this place do and can it help
 * me", not "who works here". The roster is excellent material and it now sits
 * further down, where it answers the SECOND question — "can I trust them".
 *
 * So this is: what we do, who it is for, what it costs to start, and a
 * photograph. Four facts and an image, above the fold, at sizes a person can
 * take in at a glance.
 *
 * Copy is first person throughout and reuses their own words wherever they had
 * usable ones ("no contracts, no hidden fees, no membership costs — and
 * consultations are always free" is verbatim).
 */
import { Picture } from "astro:assets";
import Lotus from "../brand/Lotus.astro";
import { SITE } from "../../config/site";
import type { ImageMetadata } from "astro";

interface Props {
  eyebrow: string;
  heading: string;
  /** The run inside `heading` that takes the gold gradient. */
  accent: string;
  lead: string;
  image: ImageMetadata;
  alt: string;
  /** Short proof points along the bottom of the hero. */
  facts: { label: string; value: string }[];
  id?: string;
}

const { eyebrow, heading, accent, lead, image, alt, facts, id } = Astro.props;

const idx = heading.indexOf(accent);
const before = idx >= 0 ? heading.slice(0, idx) : heading;
const mid = idx >= 0 ? accent : "";
const after = idx >= 0 ? heading.slice(idx + accent.length) : "";
---

<section class="hero" id={id} data-parallax-scene>
  {/* THE SIGNATURE MOMENT (CLAUDE.md §4a): a layered-depth hero. Four planes
      ride [data-depth] under motion.ts — glow deepest, the giant watermark
      lotus behind the copy, a field of drifting petals mid-depth, and the
      figure nearest the reader. Every layer is aria-hidden decoration except
      the figure; all of it is transform-only and collapses to a composed
      static under prefers-reduced-motion. */}
  <div class="hero__glow" aria-hidden="true" data-depth="0.12"></div>

  <div class="hero__watermark" aria-hidden="true" data-depth="0.28">
    <Lotus ring={false} />
  </div>

  {/* Petals adrift. Two clusters at different depths so the parallax reads as
      space between them, each on a slow CSS drift that reduced-motion zeroes. */}
  <div class="hero__petals hero__petals--far" aria-hidden="true" data-depth="0.4">
    <svg viewBox="0 0 24 24" class="petal petal--a"><path fill="currentColor" d="M12 2 C 17 8, 16 16, 12 22 C 8 16, 7 8, 12 2 Z"/></svg>
    <svg viewBox="0 0 24 24" class="petal petal--b"><path fill="currentColor" d="M12 2 C 17 8, 16 16, 12 22 C 8 16, 7 8, 12 2 Z"/></svg>
  </div>
  <div class="hero__petals hero__petals--near" aria-hidden="true" data-depth="0.55">
    <svg viewBox="0 0 24 24" class="petal petal--c"><path fill="currentColor" d="M12 2 C 17 8, 16 16, 12 22 C 8 16, 7 8, 12 2 Z"/></svg>
    <svg viewBox="0 0 24 24" class="petal petal--d"><path fill="currentColor" d="M12 2 C 17 8, 16 16, 12 22 C 8 16, 7 8, 12 2 Z"/></svg>
    <svg viewBox="0 0 24 24" class="petal petal--e"><path fill="currentColor" d="M12 2 C 17 8, 16 16, 12 22 C 8 16, 7 8, 12 2 Z"/></svg>
  </div>

  <div class="hero__inner container container--xl">
    <div class="hero__copy">
      <p class="hero__eyebrow" data-hero-settle>{eyebrow}</p>

      {/* LCP element — painted immediately, no reveal, no mask. */}
      <h1 class="hero__heading" data-hero-settle>
        {before}{mid && <span class="hero__accent">{mid}</span>}{after}
      </h1>

      <p class="hero__lead" data-hero-settle>{lead}</p>

      <div class="hero__actions" data-hero-settle>
        {/* NOT data-magnetic. It was here, and it was the wrong call: the
            engine's magnetic effect triggers within (--sig-magnet-radius +
            half the element's own size) of the element's CENTER — for this
            button, 90px + 179px ≈ 270px, a ~540px-wide zone almost ten times
            the button's own footprint. The button doesn't drift on hover, it
            drifts whenever the cursor is anywhere nearby, which reads as the
            primary CTA randomly relocating itself rather than reacting to
            you. On a medical practice's main conversion action that erodes
            trust and click precision — a moving target is a worse click
            target — so it is replaced with `.btn--glow` below: a stationary
            hover that still carries the site's gold identity. */}
        <a class="btn btn--primary btn--glow" href="/contact">
          Book a free consultation
        </a>
        <a class="btn btn--ghost" href={`tel:${SITE.phoneHref}`}>
          Call {SITE.phone}
        </a>
      </div>

      <ul class="hero__facts" data-hero-settle>
        {
          facts.map((f) => (
            <li class="fact">
              <span class="fact__value">{f.value}</span>
              <span class="fact__label">{f.label}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero__media" data-depth="0.16">
      <div class="hero__figure">
        {/* Candidates up to 1300w. The slot is ~520 CSS px on a laptop, which a
            2x display renders it well inside the cut-out's own 953px, so
            nothing is ever upscaled now. `layout="none"` is load-bearing too:
            astro.config sets image.layout to "constrained" globally, and that
            makes Astro synthesise its own srcset and silently ignore the
            widths and sizes set here. */}
        <Picture
          src={image}
          alt={alt}
          widths={[420, 620, 840, 953]}
          sizes="(min-width: 60em) 38vw, 70vw"
          formats={["avif", "webp"]}
          layout="none"
          loading="eager"
          fetchpriority="high"
          class="hero__img"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: var(--space-xl) var(--space-2xl);
    background-image: var(--grad-ink);
  }

  .hero__glow {
    position: absolute;
    inset-block-start: -20%;
    inset-inline-start: -10%;
    inline-size: 70%;
    block-size: 120%;
    background-image: var(--grad-glow);
    pointer-events: none;
    z-index: -1;
  }

  /* The watermark: the client's own mark at architectural scale, barely-there
     gold, half-cropped by the band edge. It fills what used to be dead navy
     behind the copy and gives the parallax a plane the eye can measure the
     others against. */
  .hero__watermark {
    position: absolute;
    inset-block-start: -8%;
    inset-inline-start: -12%;
    inline-size: clamp(24rem, 55vw, 46rem);
    aspect-ratio: 1;
    --lotus-size: 100%;
    opacity: 0.07;
    pointer-events: none;
    z-index: -1;
  }

  .hero__petals {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    color: var(--b-500);
  }

  .petal {
    position: absolute;
    inline-size: 1.1rem;
    opacity: 0.5;
    animation: petal-drift 14s var(--ease-in-out) infinite alternate;
  }

  .hero__petals--far .petal {
    opacity: 0.3;
    inline-size: 0.8rem;
  }

  .petal--a { inset-block-start: 18%; inset-inline-start: 44%; rotate: 18deg; }
  .petal--b { inset-block-start: 64%; inset-inline-start: 38%; rotate: -24deg; animation-delay: -5s; }
  .petal--c { inset-block-start: 12%; inset-inline-start: 58%; rotate: 40deg; animation-delay: -2s; }
  .petal--d { inset-block-start: 46%; inset-inline-start: 30%; rotate: -8deg; animation-delay: -9s; }
  .petal--e { inset-block-start: 78%; inset-inline-start: 55%; rotate: 60deg; animation-delay: -12s; }

  /* Slow, small, transform-only. The drift must never be *watched* — it is
     there so a still screenshot and a live page feel different, nothing more. */
  @keyframes petal-drift {
    from { transform: translate3d(0, 0, 0) rotate(0deg); }
    to   { transform: translate3d(0.6rem, 1.1rem, 0) rotate(14deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .petal {
      animation: none;
    }
  }

  .hero__inner {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  @media (min-width: 60em) {
    .hero__inner {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: var(--space-2xl);
    }
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.55em;
    margin: 0 0 var(--space-xs);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-brand);
  }

  .hero__eyebrow::before {
    content: "";
    inline-size: 1.75rem;
    block-size: 2px;
    border-radius: 2px;
    background-image: var(--grad-gold);
    flex-shrink: 0;
  }

  .hero__heading {
    margin: 0;
    font-family: var(--face-display);
    font-size: var(--step-6);
    font-weight: var(--weight-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    color: var(--color-ink-strong);
    text-wrap: balance;
  }

  .hero__accent {
    color: var(--color-brand);
    background-image: var(--grad-gold);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  @supports not ((background-clip: text) or (-webkit-background-clip: text)) {
    .hero__accent {
      -webkit-text-fill-color: currentColor;
    }
  }

  @media (forced-colors: active) {
    .hero__accent {
      -webkit-text-fill-color: currentColor;
      background-image: none;
    }
  }

  .hero__lead {
    margin: var(--space-s) 0 0;
    max-inline-size: 46ch;
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--color-ink);
    text-wrap: pretty;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-block-start: var(--space-l);
  }

  /* The proof strip. Sits on a gradient rule rather than a border so it reads
     as part of the hero rather than as a table bolted underneath it. */
  .hero__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-s);
    margin: var(--space-l) 0 0;
    padding-block-start: var(--space-m);
    padding-inline: 0;
    list-style: none;
    border-block-start: 1px solid transparent;
    border-image: var(--grad-rule) 1;
  }

  .fact__value {
    display: block;
    font-family: var(--face-display);
    font-size: var(--step-2);
    font-weight: var(--weight-display);
    line-height: 1.1;
    letter-spacing: var(--tracking-heading);
    color: var(--color-brand);
  }

  .fact__label {
    display: block;
    margin-block-start: 0.15em;
    font-size: var(--step--1);
    line-height: var(--leading-snug);
    color: var(--color-ink-muted);
  }

  .hero__media {
    position: relative;
  }

  /* NO FRAME, and that is the fix rather than a style preference.
     The framed 4/5 crop was fed by a 560x730 studio photograph — the largest
     copy that exists anywhere on their site — so filling a ~520px slot at 2x
     meant upscaling it past twice its real resolution, and sharpening that
     back up amplified the WebP artefacts into the mush that got flagged.

     This uses their 899x675 cut-out instead: the flat studio white is keyed to
     alpha, so she stands directly on the hero's navy with no box, no crop and
     no invented pixels. It is their largest and cleanest asset, it is already
     the right subject, and a cut-out on a gradient reads as art direction
     rather than as a photo that has been stretched. */
  .hero__figure {
    position: relative;
    display: flex;
    justify-content: center;
  }

  /* The bloom she stands in front of. Replaces the frame's job of separating
     her from the ground. */
  .hero__figure::before {
    content: "";
    position: absolute;
    inset-block: 6% -6%;
    inset-inline: -6%;
    background-image: var(--grad-glow-strong);
    pointer-events: none;
  }

  /* A soft elliptical shadow under her, so she is standing on the band rather
     than floating over it. */
  .hero__figure::after {
    content: "";
    position: absolute;
    inset-block-end: 0;
    inset-inline: 18%;
    block-size: 8%;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      rgb(16 30 48 / 0.55) 0%,
      rgb(16 30 48 / 0) 100%
    );
  }

  .hero__img {
    position: relative;
    inline-size: auto;
    max-inline-size: 100%;
    block-size: auto;
    max-block-size: 30rem;
    object-fit: contain;
    filter: var(--image-filter-hero) drop-shadow(0 18px 40px rgb(0 0 0 / 0.35));
    /* The source photograph is itself cropped at mid-thigh, so the cut-out
       ends on a hard horizontal edge. Dissolving the last few percent into the
       band turns that from a chopped image into a deliberate fade — and it is
       the reason this can sit frameless without looking unfinished. */
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 88%,
      rgb(0 0 0 / 0) 100%
    );
    mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 88%,
      rgb(0 0 0 / 0) 100%
    );
  }

  @media (min-width: 60em) {
    .hero__img {
      max-block-size: 34rem;
    }
  }

  @media (max-width: 38em) {
    .hero__facts {
      grid-template-columns: 1fr;
      gap: var(--space-xs);
    }
  }
</style>
