---
/**
 * LocationContact — map, hours, phone-first CTA and the contact form.
 *
 * The most important section on most of these sites and the one visitors
 * scroll to deliberately. The phone number is the primary action and is set at
 * display size: small businesses convert on calls (CLAUDE.md §13).
 */
import Section from "./Section.astro";
import SectionIntro from "./SectionIntro.astro";
import GoogleMap from "../core/GoogleMap.astro";
import HoursTable from "../core/HoursTable.astro";
import ContactForm, { type FormField } from "../core/ContactForm.astro";
import { SITE } from "../../config/site";
import { useTranslations, type Locale } from "../../i18n/ui";
import type { SectionProps } from "./Section.astro";

interface Props extends SectionProps {
  locale: Locale;
  eyebrow?: string;
  heading?: string;
  body?: string;
  showForm?: boolean;
  showMap?: boolean;
  showHours?: boolean;
  formFields?: FormField[];
  formSubject?: string;
  /** Standing notice rendered inside the <form>. See ContactForm. */
  formNotice?: string;
  /** The run inside `heading` that takes the gold gradient. */
  accent?: string;
  /**
   * Heading alignment. Centre by default, because on this site every
   * FULL-WIDTH band centres its heading and only the two-column MediaSplits
   * run start-aligned (their heading sits in a column beside an image).
   * This section previously used SectionHeader, whose default is `start`, so
   * the contact band broke that rhythm at the very bottom of the page —
   * immediately after the centred service-area band.
   */
  align?: "start" | "center";
  /** A second contact channel shown beside the phone, e.g. a texting line. */
  altContact?: { label: string; value: string; href: string; note?: string };
}

const {
  locale,
  eyebrow,
  heading,
  body,
  showForm = true,
  showMap = true,
  showHours = true,
  formFields,
  formSubject,
  formNotice,
  accent,
  align = "center",
  altContact,
  id = "contact",
  tone,
  spacing,
  ...rest
} = Astro.props;

const t = useTranslations(locale);
---

<Section id={id} tone={tone} spacing={spacing} width="xl" labelledBy={`${id}-heading`} {...rest}>
  <SectionIntro
    eyebrow={eyebrow}
    heading={heading ?? t("location.title")}
    accent={accent}
    lead={body}
    align={align}
    headingId={`${id}-heading`}
  />

  <div class="loc">
    <div class="loc__details stack stack--l" data-reveal-stagger>
      {/* Phone as the hero action, not a line of body copy. */}
      <div class="loc__call" data-reveal>
        <p class="loc__call-label">{t("location.phone")}</p>
        <a class="loc__call-number" href={`tel:${SITE.phoneHref}`}>
          {SITE.phone}
        </a>
      </div>

      {
        altContact && (
          <div class="loc__call" data-reveal>
            <p class="loc__call-label">{altContact.label}</p>
            <a class="loc__call-number" href={altContact.href}>
              {altContact.value}
            </a>
            {altContact.note && <p class="loc__alt-note">{altContact.note}</p>}
          </div>
        )
      }

      <div class="loc__block" data-reveal>
        <p class="loc__label">{t("location.address")}</p>
        {/* The explicit {" "} is load-bearing: Astro collapses the newline
            between two adjacent expressions, which rendered "CA91362". */}
        <address class="loc__address">
          {SITE.address.street}<br />
          {SITE.address.locality}, {SITE.address.region}{" "}
          {SITE.address.postalCode}
        </address>
        <a class="loc__link" href={SITE.mapsUrl} rel="noopener">
          {t("cta.directions")}
        </a>
      </div>

      {
        SITE.email && (
          <div class="loc__block" data-reveal>
            <p class="loc__label">{t("location.email")}</p>
            <a class="loc__link" href={`mailto:${SITE.email}`}>
              {SITE.email}
            </a>
          </div>
        )
      }

      {showHours && <div data-reveal><HoursTable locale={locale} /></div>}
    </div>

    <div class="loc__aside stack stack--l">
      {showMap && <div data-reveal><GoogleMap locale={locale} /></div>}

      {
        showForm && (
          <div data-reveal>
            <ContactForm
              locale={locale}
              fields={formFields}
              subject={formSubject}
              notice={formNotice}
            />
          </div>
        )
      }
    </div>
  </div>
</Section>

<style>
  .loc {
    display: grid;
    gap: var(--space-2xl);
  }

  .loc__call-label,
  .loc__label {
    font-size: var(--step--1);
    font-weight: var(--weight-strong);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin-block-end: var(--space-3xs);
  }

  .loc__call-number {
    /* inline-flex + min-height rather than inline-block: this is the primary
       call CTA on the section people scroll to in order to tap it, and at
       --step-4 the glyph box alone measured 36px against the engine's own
       >=44px rule (§5). This grows the hit area without moving the type. */
    display: inline-flex;
    align-items: center;
    min-block-size: 3rem;
    font-family: var(--face-display);
    font-size: var(--step-4);
    font-weight: var(--weight-display);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-brand);
    text-decoration: none;
  }

  /* The texting line's clarifier. Small, but it is doing real work: a second
     published number with no explanation reads as a mistake. */
  .loc__alt-note {
    margin-block-start: var(--space-3xs);
    font-size: var(--step--1);
    line-height: var(--leading-snug);
    color: var(--color-ink-muted);
    max-inline-size: var(--measure-narrow);
  }

  .loc__call-number:hover {
    color: var(--color-brand-strong);
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }

  .loc__address {
    color: var(--color-ink);
    margin-block-end: var(--space-3xs);
  }

  .loc__link {
    /* 20px of glyph is not a tap target. inline-flex + min-height grows the
       hit area to the engine's own >=44px floor without changing the type or
       the layout (§5). */
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    font-weight: var(--weight-medium);
    text-underline-offset: 0.18em;
  }

  @media (min-width: 60em) {
    .loc {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      gap: var(--space-3xl);
      align-items: start;
    }
  }
</style>
