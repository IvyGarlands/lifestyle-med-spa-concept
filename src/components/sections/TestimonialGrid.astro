---
/**
 * TestimonialGrid — several real reviews as static pull-quotes.
 *
 * The static counterpart to TestimonialCarousel. Prefer this one: a carousel
 * hides most of its content behind an interaction almost nobody performs, and
 * static quotes are indexable, printable and keyboard-free.
 */
import Section from "./Section.astro";
import SectionHeader from "./SectionHeader.astro";
import Stars from "../core/Stars.astro";
import type { CollectionEntry } from "astro:content";
import type { SectionProps } from "./Section.astro";
import { useTranslations, type Locale } from "../../i18n/ui";

interface Props extends SectionProps {
  locale: Locale;
  eyebrow?: string;
  heading?: string;
  body?: string;
  items: CollectionEntry<"testimonials">[];
  columns?: 2 | 3;
}

const {
  locale,
  eyebrow,
  heading,
  body,
  items,
  columns = 3,
  id = "reviews",
  tone,
  spacing,
  ...rest
} = Astro.props;

const t = useTranslations(locale);
const fmt = new Intl.DateTimeFormat(locale, { year: "numeric", month: "long" });
---

<Section id={id} tone={tone} spacing={spacing} width="xl" labelledBy={`${id}-heading`} {...rest}>
  <SectionHeader
    eyebrow={eyebrow}
    heading={heading ?? t("testimonials.title")}
    body={body}
    headingId={`${id}-heading`}
  />

  <ul
    class:list={["grid", columns === 2 ? "grid--2" : "grid--3"]}
    role="list"
    data-reveal-stagger
  >
    {
      items.map((item) => (
        <li class="review" data-reveal>
          <figure class="review__fig">
            {item.data.rating && <Stars rating={item.data.rating} size="s" />}

            <blockquote class="review__quote">
              <p>{item.data.quote}</p>
            </blockquote>

            <figcaption class="review__cite">
              <span class="review__author">{item.data.author}</span>
              <span class="review__source">
                {t("testimonials.source")} {item.data.source}
                {item.data.date && ` · ${fmt.format(item.data.date)}`}
              </span>
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .review {
    display: flex;
  }

  .review__fig {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    margin: 0;
    padding: var(--space-l);
    background-color: var(--color-surface);
    border: var(--border-hair) solid var(--color-line);
    border-radius: var(--radius-card);
    height: 100%;
  }

  .review__quote {
    font-size: var(--step-0);
    line-height: var(--leading-body);
    color: var(--color-ink);
  }

  .review__quote p {
    quotes: "\201C" "\201D";
  }

  .review__quote p::before {
    content: open-quote;
  }

  .review__quote p::after {
    content: close-quote;
  }

  .review__cite {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    /* Pin attribution to the bottom so cards of different quote lengths line up. */
    margin-block-start: auto;
    padding-block-start: var(--space-2xs);
    border-block-start: var(--border-hair) solid var(--color-line);
  }

  .review__author {
    font-size: var(--step--1);
    font-weight: var(--weight-strong);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink-strong);
  }

  .review__source {
    font-size: var(--step--1);
    color: var(--color-ink-muted);
  }
</style>
