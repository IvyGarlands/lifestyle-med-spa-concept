---
/**
 * AboutAlternating — image-and-text rows that alternate sides down the page.
 *
 * The default story section. Each row is independent, so a page can run one row
 * or five. Rows alternate automatically; nothing needs to be told its index.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Section from "./Section.astro";
import SectionHeader from "./SectionHeader.astro";
import type { SectionProps } from "./Section.astro";

export interface AboutRow {
  heading: string;
  body: string;
  image: ImageMetadata;
  alt: string;
  /** Optional stat/proof pair shown beneath the copy. */
  meta?: { label: string; value: string }[];
  ctaLabel?: string;
  ctaHref?: string;
}

interface Props extends SectionProps {
  eyebrow?: string;
  heading?: string;
  body?: string;
  rows: AboutRow[];
}

const {
  eyebrow,
  heading,
  body,
  rows,
  id = "about",
  tone,
  spacing,
  ...rest
} = Astro.props;
---

<Section
  id={id}
  tone={tone}
  spacing={spacing}
  width="xl"
  labelledBy={heading ? `${id}-heading` : undefined}
  {...rest}
>
  {
    heading && (
      <SectionHeader
        eyebrow={eyebrow}
        heading={heading}
        body={body}
        headingId={`${id}-heading`}
      />
    )
  }

  <div class="about-alt">
    {
      rows.map((row) => (
        <div class="about-alt__row" data-reveal-stagger>
          <div class="about-alt__media">
            <div class="media media--portrait media--zoom">
              <Image
                src={row.image}
                alt={row.alt}
                widths={[480, 720, 1080]}
                sizes="(min-width: 60em) 45vw, 100vw"
                loading="lazy"
              />
            </div>
          </div>

          <div class="about-alt__text">
            <h3 class="about-alt__heading" data-reveal>
              {row.heading}
            </h3>
            <p class="about-alt__body" data-reveal>
              {row.body}
            </p>

            {row.meta && row.meta.length > 0 && (
              <dl class="about-alt__meta" data-reveal>
                {row.meta.map((m) => (
                  <div>
                    <dt>{m.label}</dt>
                    <dd>{m.value}</dd>
                  </div>
                ))}
              </dl>
            )}

            {row.ctaHref && row.ctaLabel && (
              <div data-reveal>
                <a class="btn btn--secondary" href={row.ctaHref}>
                  {row.ctaLabel}
                </a>
              </div>
            )}
          </div>
        </div>
      ))
    }
  </div>
</Section>

<style>
  .about-alt {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xl);
  }

  .about-alt__row {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  .about-alt__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-s);
    max-width: var(--measure);
  }

  .about-alt__heading {
    font-size: var(--step-3);
  }

  .about-alt__body {
    color: var(--color-ink-muted);
  }

  .about-alt__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-l);
    margin-block-start: var(--space-2xs);
  }

  .about-alt__meta dt {
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .about-alt__meta dd {
    font-family: var(--face-display);
    font-size: var(--step-2);
    font-weight: var(--weight-display);
    color: var(--color-brand);
  }

  @media (min-width: 60em) {
    .about-alt__row {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-3xl);
    }

    /* Alternate: even rows put the media on the right. */
    .about-alt__row:nth-child(even) .about-alt__media {
      order: 2;
    }

    .about-alt__row:nth-child(even) .about-alt__text {
      order: 1;
      margin-inline-start: auto;
    }
  }
</style>
