---
/**
 * HeroEditorial (variant C) — type-first, with imagery kept small and secondary.
 *
 * The hardest variant to execute and the most expensive-looking when it lands.
 * Whitespace is the design: if you find yourself filling the space, use a
 * different hero.
 *
 * Suits Editorial Venue and Built Well. Needs a genuinely good headline — this
 * variant has nowhere to hide weak copy.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  eyebrow?: string;
  /** Split across lines deliberately — each entry is its own line. */
  heading: string | string[];
  body?: string;
  /** Small supporting image. Optional: type-only is a legitimate choice here. */
  image?: ImageMetadata;
  alt?: string;
  ctaLabel?: string;
  ctaHref?: string;
  /** Meta pairs rendered as a rule-separated row: est. 1974 / Providence RI */
  meta?: { label: string; value: string }[];
  id?: string;
}

const {
  eyebrow,
  heading,
  body,
  image,
  alt = "",
  ctaLabel,
  ctaHref,
  meta = [],
  id,
} = Astro.props;

const lines = Array.isArray(heading) ? heading : [heading];
---

<section id={id} class="hero-ed">
  <div class="container container--xl">
    <div class="hero-ed__top">
      {eyebrow && <p class="eyebrow" data-hero-settle>{eyebrow}</p>}

      {/* LCP text — painted, never faded in. */}
      <h1 class="hero-ed__heading">
        {lines.map((line) => <span class="hero-ed__line">{line}</span>)}
      </h1>
    </div>

    <div class="hero-ed__bottom">
      <div class="hero-ed__aside" data-hero-settle>
        {body && <p class="hero-ed__body">{body}</p>}

        {
          ctaHref && ctaLabel && (
            <a class="btn btn--secondary" href={ctaHref}>
              {ctaLabel}
            </a>
          )
        }

        {
          meta.length > 0 && (
            <dl class="hero-ed__meta">
              {meta.map((m) => (
                <div class="hero-ed__meta-item">
                  <dt>{m.label}</dt>
                  <dd>{m.value}</dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>

      {
        image && (
          <div class="hero-ed__media" data-hero-settle>
            <Image
              src={image}
              alt={alt}
              widths={[360, 540, 720]}
              sizes="(min-width: 60em) 32vw, 60vw"
              loading="eager"
              class="hero-ed__img"
            />
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .hero-ed {
    padding-block: var(--space-3xl) var(--section-y);
  }

  .hero-ed__heading {
    display: flex;
    flex-direction: column;
    font-size: var(--step-6);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    text-wrap: nowrap;
  }

  .hero-ed__line {
    display: block;
  }

  /* Every other line is indented — the single move that makes an editorial
     hero read as typeset rather than left-aligned by default. */
  .hero-ed__line:nth-child(even) {
    margin-inline-start: clamp(1rem, 6vw, 6rem);
  }

  .hero-ed__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-2xl);
    margin-block-start: var(--space-2xl);
    padding-block-start: var(--space-l);
    border-block-start: var(--border-hair) solid var(--color-line);
  }

  .hero-ed__aside {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-m);
    max-width: 38ch;
  }

  .hero-ed__body {
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--color-ink-muted);
  }

  .hero-ed__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
  }

  .hero-ed__meta-item dt {
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .hero-ed__meta-item dd {
    font-family: var(--face-display);
    font-size: var(--step-1);
    color: var(--color-ink-strong);
  }

  .hero-ed__media {
    width: min(24rem, 40vw);
    flex-shrink: 0;
  }

  .hero-ed__img {
    width: 100%;
    height: auto;
    aspect-ratio: var(--ratio-portrait);
    object-fit: cover;
    border-radius: var(--radius-image);
    filter: var(--image-filter);
  }

  /* Long headlines cannot stay nowrap on a phone. */
  @media (max-width: 48em) {
    .hero-ed__heading {
      text-wrap: balance;
      font-size: var(--step-5);
    }
    .hero-ed__line:nth-child(even) {
      margin-inline-start: 0;
    }
    .hero-ed__media {
      width: 100%;
    }
  }
</style>
