---
/**
 * QuoteBanner — a full-bleed photograph with one line over it, on parallax.
 *
 * The photo-heavy breather between content bands. The image rides
 * `[data-parallax]` (the AMBIENT tier, capped at --motion-parallax), so it
 * drifts a few percent slower than the page — depth, never a fairground ride.
 * The line over it is set in the brand script plus bold sans, so even the
 * pull-quote carries the identity.
 *
 * The scrim is non-negotiable: type never sits on raw photography.
 */
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  alt: string;
  /** The script line — usually one warm word or phrase. */
  script: string;
  /** The bold line beneath it. */
  line: string;
  attribution?: string;
  id?: string;
}

const { image, alt, script, line, attribution, id } = Astro.props;
---

<section class="qb" id={id} aria-label="Quote">
  <div class="qb__media" data-parallax>
    <Picture
      src={image}
      alt={alt}
      widths={[760, 1200, 1600]}
      sizes="100vw"
      formats={["avif", "webp"]}
      layout="none"
      loading="lazy"
      class="qb__img"
    />
  </div>

  <div class="qb__scrim" aria-hidden="true"></div>

  <div class="qb__inner container">
    <p class="qb__script" data-reveal="fade">{script}</p>
    <p class="qb__line" data-reveal>{line}</p>
    {attribution && <p class="qb__by" data-reveal="fade">{attribution}</p>}
  </div>
</section>

<style>
  .qb {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    place-items: center;
    min-block-size: clamp(18rem, 40vw, 26rem);
    padding-block: var(--space-2xl);
  }

  .qb__media {
    position: absolute;
    /* Oversized so the parallax drift never exposes the band's edges. */
    inset: -12% 0;
    z-index: -2;
  }

  .qb__img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    filter: saturate(0.85) contrast(1.02);
  }

  .qb__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      radial-gradient(
        70% 90% at 50% 50%,
        rgb(16 30 48 / 0.55) 0%,
        rgb(16 30 48 / 0.82) 100%
      );
  }

  .qb__inner {
    text-align: center;
  }

  .qb__script {
    margin: 0;
    font-family: var(--face-script);
    font-size: var(--step-4);
    line-height: 1.1;
    color: var(--b-300);
  }

  .qb__line {
    margin: var(--space-2xs) auto 0;
    max-inline-size: 26ch;
    font-family: var(--face-display);
    font-size: var(--step-3);
    font-weight: var(--weight-display);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--n-000);
    text-wrap: balance;
  }

  .qb__by {
    margin: var(--space-s) 0 0;
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--n-200);
  }
</style>
