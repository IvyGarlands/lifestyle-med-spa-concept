---
/**
 * Gallery — masonry / uniform / scroll, all with the lightbox.
 *
 * DESIGN NOTE: the three layouts are a `layout` prop rather than three files.
 * The separate-files rule in CLAUDE.md §3 governs *sections* whose structure
 * genuinely diverges; here all three share identical markup, identical
 * lightbox wiring and identical props, and differ only in how the grid is laid
 * out. Three near-identical files would be three places to fix one bug.
 *
 * Requires <Lightbox /> once in the page (BaseLayout does not include it by
 * default — a page with no gallery should not ship the dialog).
 */
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Section from "./Section.astro";
import SectionHeader from "./SectionHeader.astro";
import type { SectionProps } from "./Section.astro";
import { useTranslations, type Locale } from "../../i18n/ui";

export interface GalleryItem {
  image: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props extends SectionProps {
  locale: Locale;
  eyebrow?: string;
  heading?: string;
  body?: string;
  items: GalleryItem[];
  layout?: "masonry" | "uniform" | "scroll";
}

const {
  locale,
  eyebrow,
  heading,
  body,
  items,
  layout = "uniform",
  id = "gallery",
  tone,
  spacing,
  ...rest
} = Astro.props;

const t = useTranslations(locale);

// Pre-resolve the full-size image for each item so the lightbox has a real URL
// and real dimensions — dimensions are what stop the frame jumping per image.
const resolved = await Promise.all(
  items.map(async (item) => {
    const full = await getImage({
      src: item.image,
      width: Math.min(item.image.width, 1800),
      format: "webp",
    });
    return { ...item, full };
  })
);
---

<Section
  id={id}
  tone={tone}
  spacing={spacing}
  width="xl"
  labelledBy={heading ? `${id}-heading` : undefined}
  {...rest}
>
  {
    heading && (
      <SectionHeader
        eyebrow={eyebrow}
        heading={heading}
        body={body}
        headingId={`${id}-heading`}
      />
    )
  }

  <ul
    class:list={["gallery", `gallery--${layout}`]}
    role="list"
    data-lightbox-group
    data-reveal-stagger
  >
    {
      resolved.map((item) => (
        <li class="gallery__item" data-reveal>
          <button
            type="button"
            class="gallery__trigger"
            data-lightbox
            data-full={item.full.src}
            data-w={item.full.attributes.width ?? item.image.width}
            data-h={item.full.attributes.height ?? item.image.height}
            data-alt={item.alt}
            data-caption={item.caption}
          >
            <span class="media media--zoom gallery__media">
              <Image
                src={item.image}
                alt={item.alt}
                widths={[320, 480, 720, 1080]}
                sizes="(min-width: 72em) 26rem, (min-width: 48em) 40vw, 80vw"
                loading="lazy"
              />
            </span>
            <span class="visually-hidden">{t("gallery.open")}</span>
          </button>

          {item.caption && (
            <p class="gallery__caption" aria-hidden="true">
              {item.caption}
            </p>
          )}
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .gallery {
    --gallery-gap: var(--space-s);
  }

  .gallery__trigger {
    display: block;
    width: 100%;
    padding: 0;
    background: none;
    border: 0;
    cursor: zoom-in;
  }

  .gallery__media {
    display: block;
    width: 100%;
  }

  .gallery__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery__caption {
    margin-block-start: var(--space-3xs);
    font-size: var(--step--1);
    color: var(--color-ink-muted);
  }

  /* ---- uniform: equal square-ish cells -------------------------------- */
  .gallery--uniform {
    display: grid;
    gap: var(--gallery-gap);
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
  }

  .gallery--uniform .gallery__media {
    aspect-ratio: var(--ratio-square);
  }

  /* ---- masonry: CSS columns ------------------------------------------
     Real CSS masonry is not shippable yet, and columns give the same look
     with none of the JS. Trade-off: order runs down each column rather than
     across rows, which is fine for a photo wall and wrong for anything the
     reader must consume in sequence.                                      */
  .gallery--masonry {
    columns: 1;
    column-gap: var(--gallery-gap);
  }

  .gallery--masonry .gallery__item {
    break-inside: avoid;
    margin-block-end: var(--gallery-gap);
  }

  .gallery--masonry .gallery__media {
    aspect-ratio: auto;
  }

  .gallery--masonry .gallery__media :global(img) {
    height: auto;
  }

  @media (min-width: 40em) {
    .gallery--masonry {
      columns: 2;
    }
  }

  @media (min-width: 64em) {
    .gallery--masonry {
      columns: 3;
    }
  }

  /* ---- scroll: horizontal rail ----------------------------------------
     Keyboard users can still tab through the items and the browser scrolls
     them into view; scroll-snap makes the drag feel intentional.          */
  .gallery--scroll {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(22rem, 78vw);
    gap: var(--gallery-gap);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    /* Bleed to the viewport edge so the rail reads as continuing off-screen. */
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    padding-block-end: var(--space-s);
  }

  .gallery--scroll .gallery__item {
    scroll-snap-align: start;
  }

  .gallery--scroll .gallery__media {
    aspect-ratio: var(--ratio-portrait);
  }
</style>
