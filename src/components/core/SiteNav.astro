---
/**
 * SiteNav — sticky header with a phone-first CTA and the mobile menu trigger.
 *
 * The phone number is a first-class CTA, not a footer detail: small businesses
 * convert on calls (CLAUDE.md §13).
 *
 * Mobile menu behaviour lives in MobileNav.astro's script, which this component
 * renders. Keyboard contract: opens on click, traps focus, closes on Escape or
 * outside click, and returns focus to the trigger.
 */
import { SITE } from "../../config/site";
import { useTranslations, localizePath, type Locale } from "../../i18n/ui";
import MobileNav from "./MobileNav.astro";

export interface NavLink {
  label: string;
  href: string;
}

interface Props {
  locale: Locale;
  links: NavLink[];
  /** Current path, for aria-current. */
  current?: string;
}

const { locale, links, current = "/" } = Astro.props;
const t = useTranslations(locale);
const home = localizePath("/", locale);
---

<header class="site-header" data-site-header>
  <div class="site-header__inner container container--xl">
    <a class="site-header__brand" href={home}>
      <span class="site-header__name">{SITE.name}</span>
    </a>

    <nav class="site-header__nav" aria-label={t("nav.label")}>
      <ul class="cluster" role="list">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="site-header__link"
                aria-current={link.href === current ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="site-header__phone" href={`tel:${SITE.phoneHref}`}>
        <svg
          class="site-header__phone-icon"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          <path
            fill="currentColor"
            d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1l-2.3 2.2Z"
          ></path>
        </svg>
        <span class="site-header__phone-text">{SITE.phone}</span>
        <span class="visually-hidden">{t("cta.call")} {SITE.name}</span>
      </a>

      <MobileNav locale={locale} links={links} current={current} />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background-color: var(--color-canvas);
    border-block-end: var(--border-hair) solid var(--color-line);
    transition:
      background-color var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }

  /* .is-scrolled is toggled by motion.ts past the fold. */
  .site-header.is-scrolled {
    box-shadow: var(--shadow-m);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    min-height: var(--header-h);
    transition: min-height var(--duration-base) var(--ease-out);
  }

  .site-header.is-scrolled .site-header__inner {
    min-height: var(--header-h-scrolled);
  }

  .site-header__brand {
    font-family: var(--face-display);
    font-size: var(--step-2);
    font-weight: var(--weight-display);
    line-height: 1;
    letter-spacing: var(--tracking-heading);
    color: var(--color-ink-strong);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-header__nav {
    display: none;
  }

  .site-header__link {
    display: inline-block;
    padding-block: var(--space-2xs);
    font-size: var(--step--1);
    font-weight: var(--weight-strong);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
    border-block-end: var(--border-thick) solid transparent;
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .site-header__link:hover,
  .site-header__link[aria-current="page"] {
    color: var(--color-brand);
    border-block-end-color: var(--color-brand);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-s);
  }

  .site-header__phone {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: 2.75rem;
    padding-inline: var(--space-2xs);
    font-size: var(--step--1);
    font-weight: var(--weight-strong);
    letter-spacing: var(--tracking-label);
    color: var(--color-ink-strong);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-header__phone:hover {
    color: var(--color-brand);
  }

  .site-header__phone-icon {
    width: 1.15em;
    height: 1.15em;
    flex-shrink: 0;
    color: var(--color-brand);
  }

  /* Below the nav breakpoint the number itself is hidden but the tel: link
     stays — the icon is the tap target, and it keeps its accessible name. */
  .site-header__phone-text {
    display: none;
  }

  @media (min-width: 40em) {
    .site-header__phone-text {
      display: inline;
    }
  }

  @media (min-width: 60em) {
    .site-header__nav {
      display: block;
    }
    .site-header__nav ul {
      --cluster-gap: var(--space-m);
    }
  }
</style>
