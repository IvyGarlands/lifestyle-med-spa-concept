---
/**
 * SEOHead — every meta tag on every page. No page hand-rolls its own.
 *
 * Emits: title, description, canonical, hreflang alternates, Open Graph,
 * Twitter card, theme-colour, and the JSON-LD graph for this vertical.
 *
 * Concept (ambush) builds get `noindex,nofollow` automatically — a demo must
 * never be indexed under the real business's name (CLAUDE.md §11).
 */
import { SITE } from "../../config/site";
import { businessSchema, faqSchema, breadcrumbSchema } from "../../lib/schema";
import { localeFromUrl, localizePath, type Locale } from "../../i18n/ui";

interface Props {
  title: string;
  description: string;
  /** Absolute or root-relative. Defaults to SITE.ogImage. */
  image?: string;
  /** Path without locale prefix, e.g. "/menu". Drives canonical + hreflang. */
  path?: string;
  /** "website" for the homepage, "article" for posts. */
  ogType?: "website" | "article";
  noindex?: boolean;
  /** Rendered visibly on the page — required before emitting FAQPage. */
  faq?: { question: string; answer: string }[];
  breadcrumb?: { name: string; url: string }[];
  priceRange?: string;
}

const {
  title,
  description,
  image,
  path = "/",
  ogType = "website",
  /**
   * DEFAULTS TO TRUE. The engine default was `false`, so every page had to
   * remember to opt in and the only thing standing between a concept and
   * Google was `SITE.isConcept`. Inverting the default makes indexing the
   * thing you have to ask for.
   */
  noindex = true,
  faq = [],
  breadcrumb = [],
  priceRange,
} = Astro.props;

const locale: Locale = localeFromUrl(Astro.url);

const canonical = new URL(localizePath(path, locale), SITE.url).href;
const ogImage = new URL(image ?? SITE.ogImage, SITE.url).href;

// Title: the homepage leads with the brand; inner pages lead with the page.
const fullTitle =
  path === "/" ? `${SITE.name} — ${title}` : `${title} | ${SITE.name}`;

/**
 * The og:title carries the disclosure, because a forwarded link is the one
 * place the concept badge cannot follow. Someone pasting this URL into a
 * group chat sees "Concept redesign —" in the unfurl, before they click.
 */
const ogTitle = SITE.isConcept ? `Concept redesign — ${fullTitle}` : fullTitle;

const blockIndex = noindex || SITE.isConcept;

const schemas = [
  businessSchema({ pageUrl: canonical, imageUrl: ogImage, priceRange }),
  faqSchema(faq),
  breadcrumbSchema(breadcrumb),
].filter(Boolean);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{
  blockIndex ? (
    /* All six directives, not just the two. `noindex,nofollow` alone still
       permits a cached copy, a snippet, an image preview and a translation
       link — every one of which can surface a concept redesign under the real
       business's name. Emitted for the generic crawler and again for Google,
       which reads its own token. */
    <>
      <meta
        name="robots"
        content="noindex,nofollow,noarchive,nosnippet,noimageindex,notranslate"
      />
      <meta
        name="googlebot"
        content="noindex,nofollow,noarchive,nosnippet,noimageindex,notranslate"
      />
    </>
  ) : (
    <meta name="robots" content="index,follow,max-image-preview:large" />
  )
}

{/* hreflang — only emitted for a genuinely multilingual build. This one is
    English-only, and a self-referential hreflang pair on a single-locale site
    is noise at best. */}
{
  SITE.locales.length > 1 && (
    <>
      {SITE.locales.map((l) => (
        <link
          rel="alternate"
          hreflang={l}
          href={new URL(localizePath(path, l as Locale), SITE.url).href}
        />
      ))}
      <link
        rel="alternate"
        hreflang="x-default"
        href={new URL(localizePath(path, SITE.defaultLocale), SITE.url).href}
      />
    </>
  )
}

{/* Open Graph */}
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={locale} />

{/* Twitter */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{SITE.twitterHandle && <meta name="twitter:site" content={SITE.twitterHandle} />}

{/* Icons — generated into /public by the client scaffold. */}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

{
  schemas.map((s) => (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(s)}
    />
  ))
}
