---
/**
 * SEOHead — every meta tag on every page. No page hand-rolls its own.
 *
 * Emits: title, description, canonical, hreflang alternates, Open Graph,
 * Twitter card, theme-colour, and the JSON-LD graph for this vertical.
 *
 * Concept (ambush) builds get `noindex,nofollow` automatically — a demo must
 * never be indexed under the real business's name (CLAUDE.md §11).
 */
import { SITE } from "../../config/site";
import { businessSchema, faqSchema, breadcrumbSchema } from "../../lib/schema";
import { localeFromUrl, localizePath, type Locale } from "../../i18n/ui";

interface Props {
  title: string;
  description: string;
  /** Absolute or root-relative. Defaults to SITE.ogImage. */
  image?: string;
  /** Path without locale prefix, e.g. "/menu". Drives canonical + hreflang. */
  path?: string;
  /** "website" for the homepage, "article" for posts. */
  ogType?: "website" | "article";
  noindex?: boolean;
  /** Rendered visibly on the page — required before emitting FAQPage. */
  faq?: { question: string; answer: string }[];
  breadcrumb?: { name: string; url: string }[];
  priceRange?: string;
}

const {
  title,
  description,
  image,
  path = "/",
  ogType = "website",
  noindex = false,
  faq = [],
  breadcrumb = [],
  priceRange,
} = Astro.props;

const locale: Locale = localeFromUrl(Astro.url);

const canonical = new URL(localizePath(path, locale), SITE.url).href;
const ogImage = new URL(image ?? SITE.ogImage, SITE.url).href;

// Title: the homepage leads with the brand; inner pages lead with the page.
const fullTitle =
  path === "/" ? `${SITE.name} — ${title}` : `${title} | ${SITE.name}`;

const blockIndex = noindex || SITE.isConcept;

const schemas = [
  businessSchema({ pageUrl: canonical, imageUrl: ogImage, priceRange }),
  faqSchema(faq),
  breadcrumbSchema(breadcrumb),
].filter(Boolean);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{
  blockIndex ? (
    <meta name="robots" content="noindex,nofollow" />
  ) : (
    <meta name="robots" content="index,follow,max-image-preview:large" />
  )
}

{/* hreflang — every locale, plus x-default pointing at the default locale. */}
{
  SITE.locales.map((l) => (
    <link
      rel="alternate"
      hreflang={l}
      href={new URL(localizePath(path, l as Locale), SITE.url).href}
    />
  ))
}
<link
  rel="alternate"
  hreflang="x-default"
  href={new URL(localizePath(path, SITE.defaultLocale), SITE.url).href}
/>

{/* Open Graph */}
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={locale} />

{/* Twitter */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{SITE.twitterHandle && <meta name="twitter:site" content={SITE.twitterHandle} />}

{/* Icons — generated into /public by the client scaffold. */}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

{
  schemas.map((s) => (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(s)}
    />
  ))
}
