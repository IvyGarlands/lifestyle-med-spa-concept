---
/**
 * MobileNav — full-screen menu panel + trigger.
 *
 * Keyboard contract (CLAUDE.md §5), verified in the QA checklist:
 *   - opens on click / Enter / Space
 *   - focus moves into the panel
 *   - Tab is trapped inside the panel while open
 *   - Escape closes and returns focus to the trigger
 *   - background scroll is locked while open
 *
 * The panel is built with `hidden` + `inert` rather than display:none alone, so
 * its links are never reachable by keyboard or screen reader while closed.
 */
import { SITE } from "../../config/site";
import { useTranslations, type Locale } from "../../i18n/ui";
import type { NavLink } from "./SiteNav.astro";

interface Props {
  locale: Locale;
  links: NavLink[];
  current?: string;
}

const { locale, links, current = "/" } = Astro.props;
const t = useTranslations(locale);
---

<button
  type="button"
  class="mobile-nav__trigger"
  aria-expanded="false"
  aria-controls="mobile-nav-panel"
  data-mobile-nav-trigger
  data-label-open={t("nav.open")}
  data-label-close={t("nav.close")}
>
  <span class="mobile-nav__bars" aria-hidden="true">
    <span></span><span></span><span></span>
  </span>
  <span class="visually-hidden" data-mobile-nav-label>{t("nav.open")}</span>
</button>

<div
  id="mobile-nav-panel"
  class="mobile-nav__panel on-dark"
  data-mobile-nav-panel
  hidden
>
  <nav aria-label={t("nav.label")}>
    <ul class="stack stack--s" role="list">
      {
        links.map((link) => (
          <li>
            <a
              class="mobile-nav__link"
              href={link.href}
              aria-current={link.href === current ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <a class="btn btn--large mobile-nav__call" href={`tel:${SITE.phoneHref}`}>
    {t("cta.call")} {SITE.phone}
  </a>
</div>

<script>
  const trigger = document.querySelector<HTMLButtonElement>(
    "[data-mobile-nav-trigger]"
  );
  const panel = document.querySelector<HTMLElement>("[data-mobile-nav-panel]");
  const label = document.querySelector<HTMLElement>("[data-mobile-nav-label]");

  if (trigger && panel) {
    // Bound to non-null locals: TS narrowing does not flow into the hoisted
    // function declarations below, and `btn`/`menu` read better anyway.
    const btn = trigger;
    const menu = panel;

    const FOCUSABLE =
      'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])';

    // Read the localized strings off the DOM so this script stays i18n-free.
    const openLabel = btn.dataset.labelOpen ?? label?.textContent ?? "Menu";
    const closeLabel = btn.dataset.labelClose ?? "Close menu";

    let isOpen = false;

    const focusables = () =>
      Array.from(menu.querySelectorAll<HTMLElement>(FOCUSABLE)).filter(
        (el) => el.offsetParent !== null
      );

    function open() {
      isOpen = true;
      menu.hidden = false;
      menu.inert = false;
      // Next frame so the transition has a start state to animate from.
      requestAnimationFrame(() => menu.classList.add("is-open"));
      btn.setAttribute("aria-expanded", "true");
      btn.classList.add("is-active");
      if (label) label.textContent = closeLabel;
      document.documentElement.style.overflow = "hidden";
      focusables()[0]?.focus();
    }

    function close({ restoreFocus = true } = {}) {
      isOpen = false;
      menu.classList.remove("is-open");
      btn.setAttribute("aria-expanded", "false");
      btn.classList.remove("is-active");
      if (label) label.textContent = openLabel;
      document.documentElement.style.overflow = "";
      if (restoreFocus) btn.focus();

      // Wait out the transition before removing it from the a11y tree, but
      // make it inert immediately so it can't be tabbed into mid-close.
      menu.inert = true;
      const ms =
        parseFloat(
          getComputedStyle(document.documentElement).getPropertyValue(
            "--duration-base"
          )
        ) || 240;
      window.setTimeout(() => {
        if (!isOpen) menu.hidden = true;
      }, ms);
    }

    btn.addEventListener("click", () => (isOpen ? close() : open()));

    document.addEventListener("keydown", (e) => {
      if (!isOpen) return;

      if (e.key === "Escape") {
        e.preventDefault();
        close();
        return;
      }

      if (e.key === "Tab") {
        const items = focusables();
        if (!items.length) return;
        const first = items[0];
        const last = items[items.length - 1];
        const active = document.activeElement;

        if (e.shiftKey && active === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && active === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });

    // Tapping a link navigates; close first so the scroll lock is released
    // before the anchor jump happens.
    menu.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) close({ restoreFocus: false });
    });

    // Leaving the mobile breakpoint while open would strand the scroll lock.
    const wide = window.matchMedia("(min-width: 60em)");
    wide.addEventListener("change", (e) => {
      if (e.matches && isOpen) close({ restoreFocus: false });
    });

    // Start inert: `hidden` alone is honoured inconsistently once a stylesheet
    // sets `display` on the element.
    menu.inert = true;
  }
</script>

<style>
  .mobile-nav__trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    background: none;
    border: 0;
    color: var(--color-ink-strong);
    cursor: pointer;
  }

  .mobile-nav__bars {
    display: block;
    width: 1.5rem;
    height: 1rem;
    position: relative;
  }

  .mobile-nav__bars span {
    position: absolute;
    inset-inline: 0;
    height: 2px;
    background-color: currentColor;
    transition:
      transform var(--duration-base) var(--ease-out),
      opacity var(--duration-fast) var(--ease-out);
  }

  .mobile-nav__bars span:nth-child(1) {
    top: 0;
  }
  .mobile-nav__bars span:nth-child(2) {
    top: 50%;
    transform: translateY(-50%);
  }
  .mobile-nav__bars span:nth-child(3) {
    bottom: 0;
  }

  .mobile-nav__trigger.is-active .mobile-nav__bars span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .mobile-nav__trigger.is-active .mobile-nav__bars span:nth-child(2) {
    opacity: 0;
  }
  .mobile-nav__trigger.is-active .mobile-nav__bars span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mobile-nav__panel {
    position: fixed;
    inset: 0;
    z-index: var(--z-mobilenav);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-xl);
    padding: var(--space-2xl) var(--gutter);
    opacity: 0;
    transform: translateY(-1rem);
    transition:
      opacity var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  .mobile-nav__panel[hidden] {
    display: none;
  }

  .mobile-nav__panel.is-open {
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-nav__link {
    display: block;
    font-family: var(--face-display);
    font-size: var(--step-4);
    font-weight: var(--weight-display);
    line-height: var(--leading-heading);
    color: var(--color-ink-strong);
    text-decoration: none;
  }

  .mobile-nav__link:hover,
  .mobile-nav__link[aria-current="page"] {
    color: var(--color-brand);
  }

  .mobile-nav__call {
    align-self: flex-start;
  }

  @media (min-width: 60em) {
    .mobile-nav__trigger,
    .mobile-nav__panel {
      display: none;
    }
  }
</style>
