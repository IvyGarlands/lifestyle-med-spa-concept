---
/**
 * GoogleMap — click-to-activate facade.
 *
 * A live Google Maps iframe costs roughly 1.5MB and ~15 Lighthouse points, and
 * it sets third-party cookies before the visitor has agreed to anything. Small
 * business visitors overwhelmingly want the address and a directions link, not
 * a pannable map (CLAUDE.md §13).
 *
 * So: a static, styled placeholder with a directions button. If someone
 * genuinely wants the interactive map, one click loads it — and only then.
 *
 * The facade is drawn in CSS rather than fetched as a static map image, because
 * the Static Maps API needs a billed key and we ship sites with no accounts to
 * maintain.
 */
import { SITE } from "../../config/site";
import { useTranslations, type Locale } from "../../i18n/ui";

interface Props {
  locale: Locale;
  /** Map zoom for the embedded view. */
  zoom?: number;
  ratio?: "landscape" | "wide" | "square";
}

const { locale, zoom = 15, ratio = "landscape" } = Astro.props;
const t = useTranslations(locale);

const q = encodeURIComponent(
  `${SITE.address.street}, ${SITE.address.locality}, ${SITE.address.region} ${SITE.address.postalCode}`
);

// The keyless embed endpoint: no API key, no billing account, no maintenance.
const embedSrc = `https://maps.google.com/maps?q=${q}&z=${zoom}&output=embed`;
---

<div
  class:list={["map", `map--${ratio}`]}
  data-map
  data-src={embedSrc}
  data-title={`${t("map.staticAlt")} ${SITE.name}`}
>
  <div class="map__facade" data-map-facade>
    <div class="map__grid" aria-hidden="true"></div>

    <div class="map__card">
      <p class="map__name">{SITE.name}</p>
      <address class="map__address">
        {SITE.address.street}<br />
        {SITE.address.locality}, {SITE.address.region} {SITE.address.postalCode}
      </address>

      <div class="cluster map__actions">
        <a class="btn" href={SITE.mapsUrl} rel="noopener">
          {t("cta.directions")}
        </a>
        <button type="button" class="btn btn--secondary" data-map-load>
          {t("map.activate")}
        </button>
      </div>

      <p class="map__note">{t("map.note")}</p>
    </div>
  </div>
</div>

<script>
  const map = document.querySelector<HTMLElement>("[data-map]");
  const loadBtn = document.querySelector<HTMLElement>("[data-map-load]");

  loadBtn?.addEventListener("click", () => {
    if (!map) return;
    const facade = map.querySelector("[data-map-facade]");

    const frame = document.createElement("iframe");
    frame.src = map.dataset.src!;
    frame.title = map.dataset.title!;
    frame.loading = "lazy";
    frame.referrerPolicy = "no-referrer-when-downgrade";
    frame.className = "map__frame";
    frame.setAttribute("allowfullscreen", "");

    map.appendChild(frame);
    facade?.remove();
  });
</script>

<style>
  .map {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-image);
    background-color: var(--color-surface-sunken);
  }

  .map--landscape {
    aspect-ratio: var(--ratio-landscape);
  }
  .map--wide {
    aspect-ratio: var(--ratio-wide);
  }
  .map--square {
    aspect-ratio: var(--ratio-square);
  }

  .map__facade,
  .map :global(.map__frame) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .map__facade {
    display: grid;
    place-items: center;
    padding: var(--space-m);
  }

  /* A quiet abstract street grid. Cheap, on-brand, and obviously not a real
     map — which is the honest thing for a placeholder to be. */
  .map__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--color-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-line) 1px, transparent 1px),
      linear-gradient(var(--color-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-line) 1px, transparent 1px);
    background-size:
      7rem 7rem,
      7rem 7rem,
      1.4rem 1.4rem,
      1.4rem 1.4rem;
    opacity: 0.8;
  }

  .map__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    max-width: 26rem;
    padding: var(--space-m);
    text-align: center;
    align-items: center;
    background-color: var(--color-surface);
    border: var(--border-hair) solid var(--color-line-strong);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-m);
  }

  .map__name {
    font-family: var(--face-display);
    font-size: var(--step-2);
    font-weight: var(--weight-display);
    color: var(--color-ink-strong);
  }

  .map__address {
    color: var(--color-ink-muted);
  }

  .map__actions {
    margin-block-start: var(--space-2xs);
    justify-content: center;
  }

  .map__note {
    font-size: var(--step--1);
    color: var(--color-ink-muted);
  }
</style>
