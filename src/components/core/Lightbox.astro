---
/**
 * Lightbox — one instance per page, driven by any [data-lightbox] trigger.
 *
 * Built on <dialog> so the browser gives us the modal semantics, the top layer,
 * the backdrop and Escape-to-close for free — all of which are easy to get
 * subtly wrong by hand.
 *
 * Keyboard contract (CLAUDE.md §5):
 *   - Escape closes (native to <dialog>)
 *   - focus is trapped (native to showModal)
 *   - Arrow Left/Right move between images
 *   - focus returns to the trigger that opened it
 *
 * Triggers opt in by wrapping the thumbnail:
 *   <button data-lightbox data-full="/path.jpg" data-caption="…"
 *           data-w="1600" data-h="1067">
 */
import { useTranslations, type Locale } from "../../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<dialog class="lightbox" data-lightbox-dialog aria-label={t("gallery.label")}>
  <div class="lightbox__frame">
    <img class="lightbox__img" data-lightbox-img alt="" />

    <p class="lightbox__caption" data-lightbox-caption></p>

    <p class="lightbox__counter">
      <span data-lightbox-index>1</span>
      <span>{t("lightbox.counter")}</span>
      <span data-lightbox-total>1</span>
    </p>
  </div>

  <button
    type="button"
    class="lightbox__btn lightbox__btn--close"
    data-lightbox-close
    aria-label={t("lightbox.close")}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        d="M6 6l12 12M18 6L6 18"></path>
    </svg>
  </button>

  <button
    type="button"
    class="lightbox__btn lightbox__btn--prev"
    data-lightbox-prev
    aria-label={t("lightbox.prev")}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M15 5l-7 7 7 7"></path>
    </svg>
  </button>

  <button
    type="button"
    class="lightbox__btn lightbox__btn--next"
    data-lightbox-next
    aria-label={t("lightbox.next")}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M9 5l7 7-7 7"></path>
    </svg>
  </button>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>(
    "[data-lightbox-dialog]"
  );

  if (dialog) {
    const img = dialog.querySelector<HTMLImageElement>("[data-lightbox-img]")!;
    const caption = dialog.querySelector<HTMLElement>("[data-lightbox-caption]")!;
    const indexEl = dialog.querySelector<HTMLElement>("[data-lightbox-index]")!;
    const totalEl = dialog.querySelector<HTMLElement>("[data-lightbox-total]")!;
    const prevBtn = dialog.querySelector<HTMLElement>("[data-lightbox-prev]")!;
    const nextBtn = dialog.querySelector<HTMLElement>("[data-lightbox-next]")!;

    let triggers: HTMLElement[] = [];
    let index = 0;

    function show(i: number) {
      const trigger = triggers[i];
      if (!trigger) return;
      index = i;

      const { full, caption: cap, w, h, alt } = trigger.dataset;
      img.src = full ?? "";
      // Explicit dimensions so the frame does not jump between images.
      if (w) img.width = Number(w);
      if (h) img.height = Number(h);
      img.alt = alt ?? "";

      caption.textContent = cap ?? "";
      caption.hidden = !cap;

      indexEl.textContent = String(i + 1);
      totalEl.textContent = String(triggers.length);

      const single = triggers.length < 2;
      prevBtn.hidden = single;
      nextBtn.hidden = single;
    }

    const step = (delta: number) =>
      show((index + delta + triggers.length) % triggers.length);

    // Delegated: works for any gallery on the page, including ones added later.
    document.addEventListener("click", (e) => {
      const trigger = (e.target as HTMLElement).closest<HTMLElement>(
        "[data-lightbox]"
      );
      if (!trigger) return;

      e.preventDefault();

      // Scope to the gallery that was clicked, so two galleries on one page
      // page through their own images rather than each other's.
      const scope = trigger.closest("[data-lightbox-group]") ?? document;
      triggers = Array.from(
        scope.querySelectorAll<HTMLElement>("[data-lightbox]")
      );

      show(triggers.indexOf(trigger));
      dialog.showModal();
    });

    prevBtn.addEventListener("click", () => step(-1));
    nextBtn.addEventListener("click", () => step(1));
    dialog
      .querySelector("[data-lightbox-close]")
      ?.addEventListener("click", () => dialog.close());

    dialog.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        step(-1);
      } else if (e.key === "ArrowRight") {
        e.preventDefault();
        step(1);
      }
    });

    // Click the backdrop (i.e. the dialog itself, outside the frame) to close.
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });

    // Release the big image so it is not held in memory once closed.
    dialog.addEventListener("close", () => {
      img.removeAttribute("src");
    });
  }
</script>

<style>
  .lightbox {
    width: min(96vw, 78rem);
    max-width: none;
    max-height: 94svh;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--n-050);
    overflow: visible;
  }

  .lightbox::backdrop {
    background-color: rgb(0 0 0 / 0.86);
    /* backdrop-filter is a progressive nicety; the solid colour is the fallback. */
    backdrop-filter: blur(4px);
  }

  .lightbox__frame {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    align-items: center;
  }

  .lightbox__img {
    max-width: 100%;
    max-height: 78svh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-image);
    background-color: rgb(255 255 255 / 0.04);
  }

  .lightbox__caption {
    font-size: var(--step--1);
    text-align: center;
    max-width: var(--measure);
  }

  .lightbox__caption[hidden] {
    display: none;
  }

  .lightbox__counter {
    display: flex;
    gap: 0.35em;
    font-family: var(--face-mono);
    font-size: var(--step--1);
    opacity: 0.7;
  }

  .lightbox__btn {
    position: fixed;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    background-color: rgb(0 0 0 / 0.5);
    border: var(--border-hair) solid rgb(255 255 255 / 0.28);
    border-radius: var(--radius-pill);
    color: var(--n-000);
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .lightbox__btn:hover {
    background-color: rgb(0 0 0 / 0.8);
  }

  .lightbox__btn svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .lightbox__btn--close {
    inset-block-start: var(--space-s);
    inset-inline-end: var(--space-s);
  }

  .lightbox__btn--prev {
    inset-block-start: 50%;
    inset-inline-start: var(--space-s);
    transform: translateY(-50%);
  }

  .lightbox__btn--next {
    inset-block-start: 50%;
    inset-inline-end: var(--space-s);
    transform: translateY(-50%);
  }

  .lightbox__btn[hidden] {
    display: none;
  }
</style>
