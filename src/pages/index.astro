---
/**
 * Homepage — Lifestyle Med Spa, Agoura Hills CA. Concept redesign.
 *
 * SECTION ORDER, and why it is this order. A visitor's questions arrive in a
 * fixed sequence, and the page answers them in that sequence:
 *
 *   1. What is this?              hero — medical weight loss, physician-led
 *   2. What do you treat?         the four pillars, each with a photograph
 *   3. Tell me about the main one  GLP-1 weight management in detail
 *   4. What does it cost to ask?  free consultation, no contract, no membership
 *   5. What actually happens?     the four steps of a first visit
 *   6. Who is prescribing it?     the team, with their real faces
 *   7. Does anyone rate you?      verbatim reviews
 *   8. Do you cover where I am?   service areas
 *   9. How do I start?            location, hours, contact
 *
 * The first pass opened with the staff roster. That answered question 6 before
 * question 1 — nobody wants to know who works somewhere before they know what
 * it does. The roster is still the best material on the page; it just belongs
 * at step 6, where it is the question being asked.
 *
 * VOICE: first person throughout — this is the practice speaking. Their own
 * sentences are reused wherever they had usable ones: "no contracts, no hidden
 * fees, no membership costs — and consultations are always free" and "you're
 * not just a patient — you're family" are verbatim.
 */
import { getCollection } from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";
import HeroLead from "../components/sections/HeroLead.astro";
import PillarGrid from "../components/sections/PillarGrid.astro";
import MediaSplit from "../components/sections/MediaSplit.astro";
import StepsBand from "../components/sections/StepsBand.astro";
import TeamRoster from "../components/sections/TeamRoster.astro";
import SignedReviews from "../components/sections/SignedReviews.astro";
import AreaStrip from "../components/sections/AreaStrip.astro";
import LocationContact from "../components/sections/LocationContact.astro";
import Divider from "../components/brand/Divider.astro";

import { SITE } from "../config/site";
import { localeFromUrl } from "../i18n/ui";
import { NAV } from "../lib/nav";
import { CONTACT_FIELDS, PHI_NOTICE } from "../lib/forms";
import {
  TEAM_PHOTOS,
  imgHeroCutout,
  imgWeightLoss,
  imgTreatments,
  imgWhyChoose,
  imgHydrafacial,
  imgZoSkin,
  imgBannerB,
} from "../lib/media";

const locale = localeFromUrl(Astro.url);

const people = (await getCollection("people")).sort(
  (a, b) => a.data.order - b.data.order
);
const testimonials = (await getCollection("testimonials")).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout
  title="Medical weight loss in Agoura Hills"
  description="Physician-led medical weight loss, IV wellness and aesthetics in Agoura Hills. No contracts, no membership, and consultations are always free."
  path="/"
  navLinks={NAV}
>
  <HeroLead
    eyebrow="Agoura Hills · Physician-led"
    heading="Medical weight loss, run by people who care."
    accent="run by people who care."
    lead="We specialise in medical weight loss with a focus on GLP-1 medication, directed by a board-certified physician and prescribed by our nurse practitioner. There are no contracts, no hidden fees and no membership costs — and consultations are always free."
    image={imgHeroCutout}
    alt="A patient of Lifestyle Med Spa"
    facts={[
      { value: "Free", label: "Every consultation, always" },
      { value: "No contract", label: "Pay per visit, nothing to cancel" },
      { value: "CA · UT · TX", label: "In clinic or by telehealth" },
    ]}
  />

  <PillarGrid
    id="services"
    tone="default"
    eyebrow="What we do"
    heading="Four things, done properly."
    accent="done properly."
    lead="Weight management is where we started and it is still most of what we do. Everything else grew around it."
    pillars={[
      {
        title: "Weight management",
        body: "GLP-1 and dual-agonist medication, prescribed where it is clinically appropriate, with the work that makes it hold.",
        items: ["Mounjaro", "Ozempic", "Wegovy", "Zepbound"],
        href: "/weight-loss",
        image: imgWeightLoss,
        alt: "Medical weight loss at Lifestyle Med Spa",
      },
      {
        title: "Wellness & IV",
        body: "Vitamin IV drips, NAD+, probiotics and vitamin injections — for energy, recovery, immunity and skin.",
        items: ["NAD+ IV", "Vital Glow", "Immunity", "Athlete's Fuel"],
        href: "/wellness",
        image: imgBannerB,
        alt: "IV wellness therapy at Lifestyle Med Spa",
      },
      {
        title: "Aesthetics",
        body: "Neuromodulators, HydraFacial, plasma fibroblast and professional facials, delivered by our clinical team.",
        items: ["Botox", "Xeomin", "HydraFacial", "Plasma fibroblast"],
        href: "/aesthetics",
        image: imgHydrafacial,
        alt: "A HydraFacial treatment",
      },
      {
        title: "Medical skincare",
        body: "ZO Skin Health and Circadia, matched to your skin by the person who just treated it.",
        items: ["ZO Skin Health", "Circadia"],
        href: "/skincare",
        image: imgZoSkin,
        alt: "ZO Skin Health medical-grade skincare",
      },
    ]}
  />

  <Divider mark="wave" />

  <MediaSplit
    id="weight"
    tone="light"
    eyebrow="Our main work"
    heading="GLP-1 medication, with a physician behind it."
    accent="with a physician behind it."
    body={[
      "We specialise in medical weight loss with a focus on GLP-1 medications, combining current science with compassionate, personalised care — all designed to help you achieve safe, sustainable and lasting results.",
      "Our team takes the time to understand your individual needs. We help you create sustainable habits, improve your relationship with food, and make lifestyle adjustments that support long-term success — alongside optional therapies such as NAD+ and vitamin injections that support your metabolism, energy and overall wellness.",
      "We guide you with practical nutritional advice and lifestyle coaching tailored to your own habits, challenges and goals.",
    ]}
    points={[
      "GLP-1 agonists and GLP-1/GIP dual agonists",
      "Evaluated and prescribed by a licensed provider, where clinically appropriate",
      "Telehealth for patients in California, Utah and Texas",
      "Pre-filled syringes shipped to your home where that suits you better",
    ]}
    image={imgTreatments}
    alt="Medical weight loss treatment at Lifestyle Med Spa"
    ctaLabel="How weight loss works with us"
    ctaHref="/weight-loss"
    note="Mounjaro, Ozempic, Wegovy and Zepbound are registered trademarks of their respective owners. Listing a medication is not a claim of affiliation with or endorsement by its manufacturer."
  />

  <StepsBand
    id="how-it-works"
    tone="brand"
    eyebrow="What happens"
    heading="Four steps, and the first one is free."
    accent="the first one is free."
    steps={[
      {
        title: "Talk to us",
        body: "Call, text or book online. The consultation costs nothing and there is nothing to join.",
      },
      {
        title: "Meet a provider",
        body: "Our medical director and nurse practitioner evaluate you and build a plan around your goals.",
      },
      {
        title: "Start treatment",
        body: "Medication where it is clinically appropriate, plus the nutrition and lifestyle work beside it.",
      },
      {
        title: "Keep going",
        body: "We stay with you — adjusting, monitoring, and answering the questions as they come up.",
      },
    ]}
    note="We accept CareCredit, which offers promotional financing on purchases of $200 or more."
  />

  <MediaSplit
    id="why-us"
    tone="default"
    flip={true}
    eyebrow="Why us"
    heading="World-class care should always feel personal."
    accent="feel personal."
    body={[
      "We are a small practice on Canwood Street, open four days a week, locally operated by a board-certified medical doctor and a nurse practitioner.",
      "When you step through our doors, you're not just a patient — you're family. We'll be by your side every step of the way, empowering you to overcome obstacles, feel stronger and reach your health goals safely and sustainably.",
      "And if you can't make it in person, our medical weight loss programme is available by secure telehealth to patients across California, Utah and Texas.",
    ]}
    points={[
      "No contracts. No hidden fees. No membership costs.",
      "Consultations are always free",
      "A separate texting line, answered on the days we are open",
      "CareCredit accepted",
    ]}
    image={imgWhyChoose}
    alt="Inside Lifestyle Med Spa in Agoura Hills"
    ratio="wide"
  />

  <TeamRoster
    id="team"
    tone="light"
    eyebrow="Who treats you"
    heading="Ten of us, and we will tell you every name."
    accent="every name."
    lead="Our medical spa was founded by Kim B. Barrus, Ph.D., and is led by our medical director, Michael Rankin, MD. Kristina Dino, MSN, FNP-C, PMHNP-BC serves as our certified family nurse practitioner."
    people={people}
    photos={TEAM_PHOTOS}
    ctaLabel="Read everyone's background"
    ctaHref="/team"
  />

  <SignedReviews
    id="reviews"
    tone="default"
    eyebrow="What patients say"
    heading="Rave reviews."
    accent="Rave"
    testimonials={testimonials}
  />

  <AreaStrip
    id="areas"
    tone="light"
    spacing="tight"
    eyebrow="Where we see you"
    heading="Agoura Hills, and the valleys either side of it."
    accent="the valleys either side of it."
  />

  <LocationContact
    locale={locale}
    id="contact"
    tone="default"
    eyebrow="Visit"
    heading="30497 Canwood Street, Suite 200"
    body="Four days a week, in Agoura Hills. Telehealth is available to patients in California, Utah and Texas."
    showMap={false}
    showHours={true}
    formFields={CONTACT_FIELDS}
    formSubject="Consultation request — Lifestyle Med Spa"
    formNotice={PHI_NOTICE}
    altContact={{
      label: "Text us",
      value: SITE.textPhone,
      href: `sms:${SITE.textPhoneHref}`,
      note: "A separate line we publish for texting — useful on the three days a week we are closed.",
    }}
  />
</BaseLayout>
